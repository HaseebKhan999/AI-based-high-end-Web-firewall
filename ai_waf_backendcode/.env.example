# ============================================================================
# AI-WAF ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git (it's in .gitignore)
# ============================================================================

# ============================================================================
# FLASK APPLICATION SETTINGS
# ============================================================================
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production
HOST=0.0.0.0
PORT=5000

# ============================================================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# ============================================================================
# Option 1: Use full DATABASE_URL (recommended for Neon)
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# Option 2: Use individual components (if DATABASE_URL not set)
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_NAME=ai_waf

# Database pool settings
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_QUERY_TIMEOUT=30
LOG_RETENTION_DAYS=30

# ============================================================================
# WAF CONFIGURATION
# ============================================================================
# Threat detection threshold (0.0 to 1.0)
# Requests with score > threshold will be blocked
THREAT_THRESHOLD=0.7

# Enable/disable features
ENABLE_WAF=True
ENABLE_BLOCKING=True
ENABLE_LOGGING=True

# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================================================
# ML MODEL CONFIGURATION
# ============================================================================
# Enable ML-based detection
ENABLE_ML_DETECTION=True
ENABLE_ANOMALY_DETECTION=True

# Random Forest parameters
RF_N_ESTIMATORS=100
RF_MAX_DEPTH=20
RF_MIN_SAMPLES_SPLIT=5
RF_MIN_SAMPLES_LEAF=2
RF_MAX_FEATURES=sqrt

# Isolation Forest parameters
IF_N_ESTIMATORS=100
IF_CONTAMINATION=0.1

# Training parameters
ML_TEST_SIZE=0.2
ML_VALIDATION_SIZE=0.1

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=True

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_VERSION=1.0.0
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=500
REQUEST_TIMEOUT=30
ENABLE_API_DOCS=True

# CORS settings (comma-separated origins)
CORS_ORIGINS=*

# ============================================================================
# SECURITY CONFIGURATION (Optional - for production)
# ============================================================================
# Authentication
ENABLE_AUTHENTICATION=False
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# API Key authentication
ENABLE_API_KEY_AUTH=False
API_KEY=your-api-key-here

# Rate limiting for API
API_RATE_LIMIT=100 per minute

# HTTPS enforcement
FORCE_HTTPS=False

# ============================================================================
# DEVELOPMENT ONLY SETTINGS
# ============================================================================
# These should be False in production
FLASK_DEBUG=True
FLASK_RELOAD=True

# ============================================================================
# PRODUCTION ONLY SETTINGS
# ============================================================================
# Uncomment and set these for production deployment
# FORCE_HTTPS=True
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_HTTPONLY=True
# ENABLE_AUTHENTICATION=True
# CORS_ORIGINS=https://yourdomain.com

# ============================================================================
# NOTES:
# ============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Never commit .env to Git
# 4. For Neon PostgreSQL, get DATABASE_URL from your Neon dashboard
# 5. Change all default passwords and keys in production
# 6. Set FLASK_ENV=production when deploying